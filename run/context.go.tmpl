{{ define "func-new-templates" }}
// New creates a new Templates object
// using the passed FuncMap to initialize the templates 
func New(funcMap template.FuncMap) *Templates {
	var ts Templates

	// init base templates
	for t := range {{ .TemplateEnumType }}(templatesLen) {
		files := t.Files()
{{- if .AssetManager.IsEmbed -}}
{{/*-
	asset_manager == embed
-*/}}
		ts.templates[t] = template.Must(template.New(filepath.Base(files[0])).Funcs(funcMap).ParseFS(embeddedFS, files2paths(files)...))
{{- else -}}
{{/*-
	asset_manager == none
-*/}}
		ts.templates[t] = template.Must(template.New(filepath.Base(files[0])).Funcs(funcMap).ParseFiles(files2paths(files)...))
{{- end }}
	}
	return &ts
}
{{ end }}{{/* func-new-templates */}}



