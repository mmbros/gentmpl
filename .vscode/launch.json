    "version": "0.2.0",
    "configurations": [
        {
            "name": "help",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",

			"args": ["-h"]
        },
        {
            "name": "gen-config",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",

			"args": ["-g", "-a", "none", "-b", "tmpl", "-n", "view", "-no-cache" ]
        }
    ]
}